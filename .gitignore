# ================================
# Go Server
# ================================

# Binaries
packages/server/bin/
packages/server/*.exe
packages/server/main
packages/server/server

# Test binary, built with `go test -c`
packages/server/*.test

# Output of the go coverage tool
packages/server/*.out
packages/server/*.prof

# Go workspace file
packages/server/go.work

# Air (hot reload) temporary files
packages/server/tmp/

# Vendor directory
packages/server/vendor/

# Generated code
packages/server/docs/swagger/

